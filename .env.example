# ============================================================
# Application Configuration
# ============================================================

APP_NAME=gestalt_tutor

# ============================================================
# AI / Agent Configuration
# ============================================================

# Local LangGraph agent server (development)
AGENT_LOCAL_URL=http://127.0.0.1:2024

# Production LangGraph agent server (set when deploying)
AGENT_PRODUCTION_URL=

# Agent environment: LOCAL or PRODUCTION
AGENT_ENV=local

# LangSmith API key for tracing (optional)
LANGSMITH_API_KEY=


# ============================================================
# Backend API Configuration
# ============================================================

# Local FastAPI backend URL
LOCAL_URL=http://localhost:8000

# Production FastAPI backend URL
PRODUCTION_URL=

# Application environment: LOCAL or PRODUCTION
ENV=production


# ============================================================
# UI / Feature Flags
# ============================================================

# Show document sources in UI (True / False)
SHOW_SOURCES=True